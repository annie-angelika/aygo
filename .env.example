# aygo backend environment — copy to `.env.local` and fill in.
# `.env*` is gitignored, so secrets never get committed.

# --- Sessions (REQUIRED in production) ---------------------------------------
# Secret used to sign the guest session cookie (HMAC-SHA256). Generate a long
# random value, e.g.:  openssl rand -base64 48
# In development a built-in insecure fallback is used if this is unset.
AYGO_SESSION_SECRET=

# --- Data source -------------------------------------------------------------
# Which backend stores the data. "memory" = in-process store for local dev
# (resets on restart). "postgres" = Neon (or any Postgres). For the DB setup, use:
#   AYGO_DATA_SOURCE=postgres
AYGO_DATA_SOURCE=memory

# Postgres connection string. Required when AYGO_DATA_SOURCE=postgres.
# Neon gives you this in the dashboard (use the POOLED connection string).
# Format: postgresql://user:password@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Databases per environment ------------------------------------------------
# One Neon project ("aygo"), one BRANCH per environment — never share a branch:
#   production  → Neon branch `production` (protected). Only the Vercel
#                 "Production" environment gets its DATABASE_URL.
#   preview     → Neon branch `dev` (or a per-PR branch from the Neon↔Vercel
#                 integration). Set in the Vercel "Preview" environment.
#   development → Neon branch `dev`. That's what goes in this file locally.
# Label the branch this env points at; the server refuses to boot when the
# label and the environment don't match (prod on dev, or dev on prod):
AYGO_DB_BRANCH=dev
# Only if you deliberately need local access to production data:
# AYGO_ALLOW_PROD_DB=1
# Outside Vercel you can force the environment name (Vercel sets VERCEL_ENV):
# AYGO_ENV=development

# Token guarding the one-off setup endpoint POST /api/admin/seed (creates the
# schema + seeds cities/calendars/interest pages). Set to any long random string
# and send it as the `x-admin-token` header. Generate: openssl rand -hex 24
AYGO_ADMIN_TOKEN=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call /api from a browser. Leave
# empty for same-origin only (the app calling its own API needs no entry).
# Example: https://aygo.app,https://staging.aygo.app
AYGO_CORS_ORIGINS=

# --- Frontend → API ----------------------------------------------------------
# Where the client hooks (lib/api/*) send requests. Defaults to "/api" (this
# app's own route handlers); only set it to point at another host.
# NEXT_PUBLIC_API_URL=/api

# Contact for the OpenStreetMap geocoder's User-Agent (its usage policy asks
# for a way to reach the operator): an email or a URL.
AYGO_CONTACT=

# --- Pollar social login (https://dashboard.pollar.xyz) ----------------------
# Publishable key passed to @pollar/react in the browser (safe to expose).
# `pub_testnet_…` for development, `pub_mainnet_…` for production. While unset,
# the app still browses; only the login flow is inert.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Stellar network the SDK targets: "testnet" (default) or "mainnet".
NEXT_PUBLIC_POLLAR_NETWORK=testnet
# Pollar API host — only if you were given a non-default one. The server uses
# it too: sign-ins are verified by relaying the browser's DPoP proof to
# <base>/v1/auth/session/resume (see lib/server/pollar.ts).
# NEXT_PUBLIC_POLLAR_BASE_URL=https://sdk.api.pollar.xyz
